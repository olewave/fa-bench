# FA-Bench — this machine's settings. Copy to `.fabench.env` (gitignored):
#
#     cp .fabench.env.example .fabench.env
#
# Both worlds read that file: the `fabench` CLI applies it before loading a
# config, and `evals/env.sh` sources it for the shell drivers. KEY=value lines
# are valid shell, which is why one file can serve both.
#
# An already-exported variable ALWAYS wins over this file, so a one-off
#     FABENCH_THREADS=8 ./evals/run_evals.sh mfa
# overrides without editing anything.
#
# WHAT BELONGS HERE: what the MACHINE is. What the RUN is — which corpora, on
# which subset, which systems, how scored — needs no file at all: it composes
# from the tree that owns it (datasets/<lang>/config.yaml, evals/config.yaml,
# fabench/*/config.yaml). This is the one file `fabench init` writes.

# --- staged corpora -------------------------------------------------------
# Licensed and never downloaded: stage them yourself, then say where they are.
# `fabench init` fills these in; a run config naming a root would win over them.
#FABENCH_TIMIT_ROOT=/data/speech/TIMIT
#FABENCH_BUCKEYE_ROOT=/data/speech/Buckeye

# --- where bulk output goes -----------------------------------------------
# work_dir holds mixes and caches and gets large; results holds leaderboards.
#FABENCH_WORK_DIR=/fast/scratch/fabench
# Defaults to summary/local -- YOUR runs, gitignored. summary/ is the sweep's
# script output (also gitignored); the published tree is records/, written
# only by evals/publish_records.py.
#FABENCH_RESULTS_DIR=/data/fabench-results

# --- commercial ASR credentials (track 2, one step) -----------------------
# Only needed to run deepgram, assemblyai, elevenlabs or google_stt. Nothing
# reaches a paid endpoint without one of these set, and the adapters read the
# environment only -- never a tracked config -- so a key cannot reach the
# history. Check one with:
#     evals/timestamp_asrs/cloud_check.py deepgram
# Responses are cached under evals/timestamp_asrs/<tool>/cache/, so a rescore
# or a restart costs nothing.
#DEEPGRAM_STT_API_KEY=
#ASSEMBLYAI_STT_API_KEY=
#ELEVENLABS_STT_API_KEY=
# Google takes either an API key (v1, the default path) or an OAuth bearer
# token (required if the recipe sets project_id, i.e. v2). With neither set the
# adapter runs `gcloud auth print-access-token`, so an authenticated machine
# needs nothing here.
#GOOGLE_STT_API_KEY=
#GOOGLE_STT_ACCESS_TOKEN=
#SPEECHMATICS_STT_API_KEY=
# IBM Watson needs a key AND the endpoint for your own service instance, which
# is account-specific and so does not belong in a tracked recipe. The bare
# regional URL also authenticates with an IAM key; naming the instance says
# which service the numbers were billed to.
#IBM_STT_API_KEY=
#IBM_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com/instances/<instance-id>

# Amazon Transcribe. FOUR values, not one: the signature covers the whole
# request, so the key id and the secret are both part of it, and batch
# Transcribe reads its audio from S3 rather than taking it in the request. The
# bucket is staging only and each object is deleted as soon as its transcript
# returns. It MUST be in the same region as the endpoint.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=          # only for temporary credentials
#AWS_REGION=us-west-1
#AWS_S3_BUCKET=

# Azure AI Speech, fast transcription. The portal issues TWO interchangeable
# keys per resource so one can rotate while the other serves; either name
# works and the first one set wins. The endpoint is on the same Keys and
# Endpoint page and is NOT optional: a multi-service resource refuses the
# regional gateway and answers only on its own custom subdomain.
#AZURE_STT_API_KEY1=
#AZURE_STT_API_KEY2=
#AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
#AZURE_SPEECH_REGION=        # instead of the endpoint, for a single-service resource

# --- repairing a damaged sweep --------------------------------------------
# A noisy cell holding fewer records than its split is re-run rather than
# skipped, but only below this fraction. Short is not always damaged: a cascade
# drops an utterance its upstream ASR heard as nothing, and NeMo-FA 80 ms drops
# 32 short Buckeye utterances by design, both landing at 93-100%. A cell cut off
# by an expired token sat at 19%. Default 0.90.
#FABENCH_REDO_BELOW=0.90

# Which track rescore_all.sh rebuilds. The two are scored independently, so
# adding one Track 2 cascade changes every timestamp_asrs leaderboard and no
# aligners one, and the default run then spends half its wall clock rewriting
# files with identical content. Unset means both.
#FABENCH_KINDS=timestamp_asrs

# --- how the box is used (read by evals/env.sh) ---------------------------
# Which GPUs a sweep may use. UNSET means all of them, which is correct on
# every machine; set it only to pin a sweep to specific cards. Set it EMPTY
# (`FABENCH_CUDA_DEVICES=`) to expose none and run on CPU.
#FABENCH_CUDA_DEVICES=0,1
# BLAS/OMP threads per aligner process. 1 keeps a multi-tool sweep from
# thrashing (measured 40x throughput loss unpinned); raise it when running a
# single tool.
#FABENCH_THREADS=1

# --- external tool locations ----------------------------------------------
# MFA and the kalpy scoring bridge shell into a micromamba env.
#FABENCH_MICROMAMBA=$HOME/micromamba/bin/micromamba
#FABENCH_MAMBA_ROOT=$HOME/micromamba
# Research checkouts that are not pip-installable.
#FABENCH_MAPS_REPO=tools/MAPS
#FABENCH_MAPS_PYTHON=tools/maps_env/bin/python
#FABENCH_NEUFA_REPO=tools/NeuFA

# --- noise augmentation (datasets/prep/augment.sh) ------------------------
# The PARENT of the per-corpus trees, each holding noisy/<type>/<utt>.wav --
# i.e. <root>/TIMIT/noisy/babble/... So this is usually the directory the
# staged corpora themselves sit in, not a separate one.
#FABENCH_NOISY_ROOT=/data/speech/english
# Where the per-condition shadow roots are built (one dir per corpus x type).
# These are symlink trees, so they are small; the audio they point at is not.
#FABENCH_SHADOW=data/shadow
# MUSAN and the RIR corpus, read by make_noisy.py (step 2).
#MUSAN=/data/speech/audio/musan
#RIRS=/data/speech/audio/RIRS_NOISES

# --- optional -------------------------------------------------------------
# A run config to use when --config is omitted. There is no magic filename:
# without this (or --config) a run uses the composed defaults.
#FABENCH_CONFIG=/path/to/my.yaml
# Fixtures for tests that otherwise self-skip.
#FABENCH_TEST_LJ_WAV=/data/LJSpeech-1.1/wavs/LJ001-0002.wav
#OLIGN_TEST_WAV=/data/olign/short1.wav
#OLIGN_TEST_HOST=127.0.0.1
#OLIGN_TEST_PORT=8848

# Restrict a sweep to specific cells, ';'-separated as "<corpus> <subset>".
# Unset means the full grid. Set it to split one sweep across several GPUs by
# launching one run_evals.sh per cell:
#   FABENCH_CELLS="buckeye test" FABENCH_DEVICE=cuda:3 ./evals/run_evals.sh qwen3_asr
# FABENCH_CELLS="timit core_test;buckeye test"
